# Copy to .env and fill in real values. .env is gitignored.
#
# DATABASE_URL is the only required variable — paste your Neon pooled
# connection string (Project → Dashboard → Connection string → Pooled).
PORT=8080
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
MAX_WORKERS=64
CHECK_INTERVAL_SECONDS=30
CHECK_TIMEOUT_SECONDS=10
DOMAIN_RPS=5
